PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ใช้เซ็น/ตรวจสอบ JWT สำหรับระบบเข้าสู่ระบบ (auth) ต้องเป็นค่าสุ่ม เก็บเป็นความลับ
# ต้องยาวอย่างน้อย 32 ตัวอักษร (บังคับใน src/config.ts) ถ้าสั้นกว่านี้ server จะไม่สตาร์ท
# ห้าม fallback เป็นค่า default ใด ๆ ในโค้ด — ไม่ตั้งค่านี้แล้ว server จะไม่สตาร์ท (fail closed)
# สร้างค่าใหม่ด้วย:  openssl rand -base64 48
JWT_SECRET=
# โหมดผู้ช่วย AI: mock = ตอบด้วยกฎ + ข้อมูลจริงจากฐานข้อมูล (ค่าเริ่มต้น, ใช้สำหรับสาธิต)
#                live = เรียกโมเดล Gemini จริง (ต้องมี GEMINI_API_KEY)
AI_MODE=mock

# ผู้ให้บริการโมเดลภาษาที่ใช้ตอนโหมด live: claude (ค่าเริ่มต้น) หรือ gemini
# (gemini เก็บไว้เป็นทางหนีทีไล่ชั่วคราวเท่านั้น) — ไม่มีผลกับ embeddings/ค้นคู่มือ
# ซึ่งยังใช้ Gemini เสมอผ่าน GEMINI_API_KEY ด้านล่าง
AI_PROVIDER=claude

# ใช้เมื่อ AI_MODE=live และใช้สำหรับ index คู่มือ (npm run index:manuals) เสมอ
# (ไม่ว่า AI_PROVIDER จะเป็นอะไร embeddings ยังใช้ Gemini)
GEMINI_API_KEY=
# ใช้เมื่อ AI_MODE=live และ AI_PROVIDER=claude (ค่าเริ่มต้น) — คีย์สำหรับ Anthropic Claude
ANTHROPIC_API_KEY=
CORS_ORIGIN=http://localhost:3000

PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ใช้เซ็น/ตรวจสอบ JWT สำหรับระบบเข้าสู่ระบบ (auth) ต้องเป็นค่าสุ่ม เก็บเป็นความลับ
# ต้องยาวอย่างน้อย 32 ตัวอักษร (บังคับใน src/config.ts) ถ้าสั้นกว่านี้ server จะไม่สตาร์ท
# ห้าม fallback เป็นค่า default ใด ๆ ในโค้ด — ไม่ตั้งค่านี้แล้ว server จะไม่สตาร์ท (fail closed)
# สร้างค่าใหม่ด้วย:  openssl rand -base64 48
JWT_SECRET=
# โหมดผู้ช่วย AI: mock = ตอบด้วยกฎ + ข้อมูลจริงจากฐานข้อมูล (ค่าเริ่มต้น, ใช้สำหรับสาธิต)
#                live = เรียกโมเดล Gemini จริง (ต้องมี GEMINI_API_KEY)
AI_MODE=mock

# ใช้เมื่อ AI_MODE=live และใช้สำหรับ index คู่มือ (npm run index:manuals) เท่านั้น
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CORS_ORIGIN=http://localhost:3000

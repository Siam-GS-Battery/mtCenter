PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# โหมดผู้ช่วย AI: mock = ตอบด้วยกฎ + ข้อมูลจริงจากฐานข้อมูล (ค่าเริ่มต้น, ใช้สำหรับสาธิต)
#                live = เรียกโมเดล Gemini จริง (ต้องมี GEMINI_API_KEY)
AI_MODE=mock

# ใช้เมื่อ AI_MODE=live และใช้สำหรับ index คู่มือ (npm run index:manuals) เท่านั้น
GEMINI_API_KEY=
# ต้องตั้งค่านี้ก่อนถึงจะสร้าง/แก้ไข/ลบคู่มือได้ (POST/PATCH/DELETE /api/manuals)
# ผู้เรียกต้องส่ง header "x-manual-admin-secret" ให้ตรงกับค่านี้ มิฉะนั้นจะถูกปฏิเสธ
MANUAL_ADMIN_SECRET=
CORS_ORIGIN=http://localhost:3000

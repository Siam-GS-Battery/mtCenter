# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Base URL of the REST backend consumed by the frontend apiService layer.
VITE_API_URL=http://localhost:4000

# MANUAL_ADMIN_SECRET: Shared secret required by the backend's manual admin
# routes (POST /api/manuals, PATCH/DELETE /api/manuals/:id). Must match the
# backend's MANUAL_ADMIN_SECRET value exactly. Read server-side only by
# server.ts, which attaches it as the "x-manual-admin-secret" header when
# proxying create/edit/delete manual requests — it is NEVER exposed to the
# browser bundle (do not prefix with VITE_).
MANUAL_ADMIN_SECRET=

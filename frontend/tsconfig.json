{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    // Without this, the `| null` on Machine.healthScore / SparePart.unitPriceTHB /
    // etc. is erased and TypeScript silently allows `null < 50` (JS coerces null
    // to 0), which is exactly how every machine with no telemetry ended up
    // displaying a false critical-health alarm. Keep it on.
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // ฉาก Three.js ชุดเดิม (plant/, KitMachine*, vendor kit) ถูกย้ายไป
  // components/views/liveFloor/_archive/ เพื่อเก็บไว้อ้างอิงตอนสร้างฉากใหม่.
  // ไม่มีไฟล์ไหน import มันแล้ว จึงไม่ต้อง typecheck (import ข้างในพังตามการย้าย).
  "exclude": ["**/_archive/**", "dist", "node_modules"]
}
